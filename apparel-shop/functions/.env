# CCIG Apparel Shop — Cloud Functions configuration (non-secret values).
# Placeholders are fine while testing. See ../README.md for what each one does.

# Where "An order has been placed for CCIG Apparel." emails go, and the
# mailbox the "CCIG APPAREL ORDER SUMMARY" confirmation is sent from.
ORDER_INBOX=nick.kokat@thinkccig.com

# Only accounts on this domain can use the shop.
ALLOWED_DOMAIN=thinkccig.com

# How email is delivered:
#   log   = don't send; write each email to the mail_log collection + function logs (testing)
#   smtp  = CCIG's chosen setup. Both emails are sent from the SMTP_USER mailbox (Nick's).
#           The order email shows "First Last via CCIG Apparel", has Reply-To set to the
#           orderer, and its body starts with "The request is from: First Last".
#           No IT app registration needed. Needs the mailbox password in EMAIL_SECRET.
#   graph = Microsoft 365 Graph API (needs an IT-approved app registration); the order email
#           comes FROM the orderer's own mailbox. Not used for now.
# Switch this to smtp once the real mailbox password is set with:
#   firebase functions:secrets:set EMAIL_SECRET
EMAIL_TRANSPORT=log

# SMTP settings (EMAIL_TRANSPORT=smtp). SMTP_USER is usually the ORDER_INBOX mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=nick.kokat@thinkccig.com

# Microsoft Graph settings (EMAIL_TRANSPORT=graph). From the Entra ID app registration.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Subtract ordered quantities from the size counts when an order is placed.
DECREMENT_INVENTORY=true

# Link included in the confirmation email.
SHOP_URL=https://ccig-apparel-shop.web.app
